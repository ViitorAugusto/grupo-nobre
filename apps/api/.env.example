# Copie para .env (npm run setup faz isso). Valores só para a máquina local.

# Servidor
PORT=3333
# Origem do frontend autorizada no CORS (uma só, sem curinga)
CORS_ORIGIN=http://localhost:3000

# Banco (mesmo usuário/senha de desenvolvimento do docker-compose.yml; não é segredo)
# secretlint-disable-next-line
DATABASE_URL=postgresql://crm:crm_local@localhost:5433/crm_nobre?schema=public
# Banco dos testes e2e (criado pelo docker/postgres/init)
# secretlint-disable-next-line
DATABASE_URL_TEST=postgresql://crm:crm_local@localhost:5433/crm_nobre_test?schema=public

# Regras de negócio (premissas configuráveis, ver docs/decisoes/premissas.md)
# "Hoje" do sistema. Formato AAAA-MM-DD. A demonstração usa 2026-10-15.
REFERENCE_DATE=2026-10-15
# A2: dispara com MAIS de N dias sem contato
ATTENTION_NO_CONTACT_DAYS=5
# A3: dispara com N dias ou menos até o evento
ATTENTION_EVENT_WINDOW_DAYS=7

# Fila de retorno do dia: expressão cron do disparo automático, no fuso indicado
FOLLOW_UP_QUEUE_CRON=0 7 * * *
FOLLOW_UP_QUEUE_TIMEZONE=America/Sao_Paulo
